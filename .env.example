# Port to listen on (default: 3000)
PORT=3000

# Directory where SQLite road-trip saves are stored (default: ./data)
DATA_DIR=./data

# Optional: Passphrase required to create a BRAND NEW road trip.
# Recommended when hosting publicly (Fly.io / Railway) so strangers cannot create rooms.
# Players joining via an existing invite link NEVER need this passphrase.
HOST_SECRET=

# Optional: Advertised LAN IP or public domain for QR codes (auto-detected if omitted)
PUBLIC_HOST=

# Set to "true" behind HTTPS in production (Fly.io / Railway)
ENABLE_HSTS=false
