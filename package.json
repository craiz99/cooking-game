{
  "name": "purple-van-cooking-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Purple Van Road Trip — 1-3 player cooperative browser PWA cooking game from Sharon, MA to San Jose, CA",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
